{
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/@motion/",
      "destination": "/@motion",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/@motion",
      "destination": "/index.html"
    }
  ]
}
